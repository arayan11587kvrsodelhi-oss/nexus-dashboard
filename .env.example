# NEXUS Dashboard Environment Configuration

# Server Port & Environment
PORT=8130
NODE_ENV=production

# Target GitHub Account (Username whose repositories and activity are displayed)
GITHUB_USERNAME=arayan11587kvrsodelhi-oss

# GitHub Personal Access Token (Classic or Fine-Grained PAT)
# CRITICAL FOR PRODUCTION (e.g. Render / Cloud Hosting):
# Without a token, GitHub limits unauthenticated requests to 60/hour per IP address.
# In shared cloud environments (Render, Railway, Fly.io), egress IPs are shared and rate-limited.
# Setting a token increases the limit to 5,000 requests/hour.
# Permissions required: public repository read-only (no private repo access needed).
GITHUB_TOKEN=

# GitHub API Base URL
GITHUB_API_BASE_URL=https://api.github.com

# Server-Side Cache TTL (milliseconds, default 5 minutes)
GITHUB_CACHE_TTL_MS=300000

# Manual Refresh Rate Limiting (window in ms, max requests per window)
REFRESH_RATE_LIMIT_WINDOW_MS=30000
REFRESH_RATE_LIMIT_MAX=1

# Log Level: error | warn | info | debug
LOG_LEVEL=info
