{
  "name": "nexus-dashboard",
  "version": "2.2.0",
  "private": true,
  "description": "NEXUS - a live, single-owner developer intelligence dashboard backed by the GitHub API.",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "node tests/run-browser-qa.mjs",
    "build": "node scripts/build-check.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jsdom": "^24.1.0",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0",
    "vitest": "^2.0.5"
  }
}
